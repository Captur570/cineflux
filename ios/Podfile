# Lecteur vidéo VLC 4 (lit tous les formats : MKV, TS, HLS, AC3, DTS, 4K…)
platform :ios, '15.0'
use_frameworks!
inhibit_all_warnings!

target 'ShippoTV' do
  pod 'VLCKit', '4.0.0a25'          # VLC 4 : sous-titres dans les bandes noires
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
